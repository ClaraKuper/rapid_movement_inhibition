    "study_name = 'target_polarity'\n",
    "study_type = 'remote'\n",
    "data_path = f'../../../data/{study_type}/data_{study_name}'\n",
    "results_path = f'../../../results/{study_type}/results_{study_name}'"
   ]
  },
